{
  // Configuración de Cloudflare: publica la carpeta dist como sitio estático.
  // worker.js solo redirige www → dominio principal; todo lo demás lo sirve ASSETS.
  "name": "contadorecommerce",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
