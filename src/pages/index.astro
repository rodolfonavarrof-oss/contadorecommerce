---
import Landing from '../layouts/Landing.astro';
import { SITE, PLANS, FAQS, whatsappLink, MAILERLITE_ACCOUNT_ID, MAILERLITE_FORM_ID } from '../config';

const wa = whatsappLink();

const offerSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Contabilidad para tiendas online',
  serviceType: 'Contabilidad y asesoría tributaria para e-commerce',
  provider: { '@id': `${SITE.url}/#negocio` },
  areaServed: { '@type': 'Country', name: 'Chile' },
  offers: PLANS.map((p) => ({
    '@type': 'Offer',
    name: `Plan ${p.name}`,
    description: p.audience,
    price: p.priceValue,
    priceCurrency: p.currency,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: p.priceValue,
      priceCurrency: p.currency,
      unitText: 'MONTH',
      valueAddedTaxIncluded: false,
    },
  })),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Landing title={SITE.name} schema={[offerSchema, faqSchema]}>
<style is:global>

body{margin:0;background:#FFFFFF;color:#0B1533;font-family:'Geist',system-ui,-apple-system,sans-serif;-webkit-font-smoothing:antialiased}
a{color:#0034D3}a:hover{color:#002699}
.wrap{max-width:1200px;margin:0 auto;padding-inline:max(20px,4vw)}
.hero{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:56px;align-items:center}
.bento{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:16px}
.span3{grid-column:span 3}.span2{grid-column:span 2}.span4{grid-column:span 4}
.three{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.four{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
.split{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:48px;align-items:center}
.logos{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:12px}
@media (max-width:960px){.hero,.split{grid-template-columns:minmax(0,1fr);gap:40px}.span3,.span2,.span4{grid-column:span 6}.three{grid-template-columns:minmax(0,1fr)}.four{grid-template-columns:repeat(2,minmax(0,1fr))}.logos{grid-template-columns:repeat(4,minmax(0,1fr))}.navlinks{display:none!important}.float{display:none!important}}
@media (max-width:560px){.four{grid-template-columns:minmax(0,1fr)}}
@media (max-width:960px){.steps3{grid-template-columns:minmax(0,1fr)!important;gap:12px!important}.steps3 .arrow{transform:rotate(90deg);height:36px}}
.cmp{width:100%;border-collapse:collapse;font-size:14px;min-width:720px}
.cmp th,.cmp td{padding:13px 12px;border-bottom:1px solid #E3E1DA;text-align:center}
.cmp th[scope=row]{text-align:left;font-weight:500;color:#33384D}
.cmp thead th{font-size:15px;font-weight:600;padding-block:16px}
.cmp .hl{background:#EAF1FF}
.yes{color:#0034D3;font-weight:600}.no{color:#B9BBC8}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.35;transform:scale(.8)}}
@keyframes ring{0%{box-shadow:0 0 0 0 rgba(0,52,211,.45)}100%{box-shadow:0 0 0 10px rgba(0,52,211,0)}}
@keyframes tick{0%,12%{opacity:0;transform:scale(.4)}22%,88%{opacity:1;transform:scale(1)}100%{opacity:0;transform:scale(1)}}
@keyframes rowin{0%,12%{background:#FFFFFF}22%,88%{background:#EEF4FF}100%{background:#FFFFFF}}
@keyframes grow{0%{width:4%}70%,100%{width:100%}}
@keyframes floaty{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
.live{animation:pulse 1.6s ease-in-out infinite}
.ring{animation:ring 1.8s ease-out infinite}
.t1,.t2,.t3,.t4{animation:tick 6s ease-out infinite both}
.t2{animation-delay:.9s}.t3{animation-delay:1.8s}.t4{animation-delay:2.7s}
.r1,.r2,.r3,.r4{animation:rowin 6s ease-out infinite both}
.r2{animation-delay:.9s}.r3{animation-delay:1.8s}.r4{animation-delay:2.7s}
.bar{animation:grow 5s ease-in-out infinite alternate}
.fl1{animation:floaty 5s ease-in-out infinite}.fl2{animation:floaty 6s ease-in-out .8s infinite}
@media (prefers-reduced-motion:reduce){.live,.ring,.t1,.t2,.t3,.t4,.r1,.r2,.r3,.r4,.bar,.fl1,.fl2{animation:none;opacity:1}}
@keyframes rot{0%,18%{transform:translateY(0)}25%,43%{transform:translateY(-1.5em)}50%,68%{transform:translateY(-3em)}75%,93%{transform:translateY(-4.5em)}100%{transform:translateY(-6em)}}
.rot-in{animation:rot 10s cubic-bezier(.7,0,.3,1) infinite}
@keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.marquee{animation:marquee 32s linear infinite}
@media (prefers-reduced-motion:reduce){.rot-in,.marquee{animation:none}}
.dd path,.dd circle{fill:none;stroke:currentColor;stroke-width:9;stroke-linecap:round;stroke-linejoin:round}
@keyframes draw{0%{stroke-dashoffset:1}35%,100%{stroke-dashoffset:0}}
.draw path,.draw circle{stroke-dasharray:1;animation:draw 7s ease-in-out infinite}
@media (prefers-reduced-motion:reduce){.draw path,.draw circle{animation:none;stroke-dasharray:none}}
:focus-visible{outline:3px solid #0034D3;outline-offset:3px}

html{scroll-behavior:smooth;scroll-padding-top:80px}
section{overflow-x:clip}
@media (max-width:560px){.kv{font-size:18px!important}header.wrap{gap:12px!important}header.wrap a:first-child{font-size:21px!important}}
img{max-width:100%}
</style>


<div style="min-width: 0">

<!-- NAV -->
<div class="topbar" style="position: sticky; top: 0; z-index: 50; padding-top: env(safe-area-inset-top, 0px); background: rgba(255,255,255,0.94); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); border-bottom: 1px solid #E3E1DA">
<header class="wrap" style="display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-block: 12px">
  <a href="#inicio" aria-label="contador.ecommerce, inicio" style="text-decoration: none; color: #0B1533; font-family: 'Host Grotesk', sans-serif; font-size: 24px; letter-spacing: -0.045em; white-space: nowrap"><b style="font-weight: 700">contador</b><b style="font-weight: 700; color: #0034D3">.</b><span style="font-weight: 400; color: #4A5068">ecommerce</span></a>
  <nav class="navlinks" style="display: flex; gap: 32px; font-size: 15px">
    <a href="#recibes" style="color: #4A5068; text-decoration: none">Servicio</a>
    <a href="#planes" style="color: #4A5068; text-decoration: none">Planes</a>
    <a href="#rodolfo" style="color: #4A5068; text-decoration: none">Nosotros</a>
    <a href="#newsletter" style="color: #4A5068; text-decoration: none">Newsletter</a>
  </nav>
  <a href={wa} style="display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border-radius: 12px; background: #0034D3; color: #FFFFFF; text-decoration: none; font-weight: 500; font-size: 15px; white-space: nowrap">Comienza ahora</a>
</header>
</div>

<!-- HERO -->
<section id="inicio" class="wrap" style="padding-block: 64px 72px">
  <div class="hero">
    <div style="display: flex; flex-direction: column; gap: 28px; min-width: 0">
      <p style="margin: 0; align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; background: #EAF1FF; color: #0034D3; font-size: 13px; font-weight: 500"><span class="live" aria-hidden="true" style="width: 7px; height: 7px; border-radius: 50%; background: #0034D3"></span>Contabilidad para tiendas online</p>
      <p style="margin: 0; display: flex; align-items: center; gap: 10px; font-size: 18px; color: #4A5068">Para
        <span class="rot" style="display: inline-block; height: 1.5em; overflow: hidden; vertical-align: bottom"><span class="rot-in" style="display: flex; flex-direction: column; color: #0034D3; font-weight: 600"><span style="height: 1.5em; line-height: 1.5em">tiendas que recién parten</span><span style="height: 1.5em; line-height: 1.5em">marcas que están creciendo</span><span style="height: 1.5em; line-height: 1.5em">vendedores de Mercado Libre</span><span style="height: 1.5em; line-height: 1.5em">tiendas que invierten en Meta</span><span style="height: 1.5em; line-height: 1.5em">tiendas que recién parten</span></span></span></p>
      <h1 style="margin: 0; font-weight: 600; font-size: clamp(44px, 6vw, 80px); line-height: 1; letter-spacing: -0.045em; text-wrap: balance">Tus números claros, cada mes.</h1>
      <p style="margin: 0; font-size: 20px; line-height: 1.45; color: #4A5068; max-width: 34ch">Impuestos al día y un reporte que te dice cuánto ganaste y por qué.</p>
      <div style="display: flex; gap: 12px; flex-wrap: wrap">
        <a href={wa} style="display: inline-flex; align-items: center; gap: 10px; min-height: 52px; padding: 0 24px; border-radius: 14px; background: #0034D3; color: #FFFFFF; text-decoration: none; font-weight: 500; font-size: 16px">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 256 256"><g fill="currentColor"><path d="M224 128a96 96 0 0 1-144.07 83.11l-37.39 12.47a8 8 0 0 1-10.12-10.12l12.47-37.39A96 96 0 1 1 224 128" opacity=".2"/><path d="M128 24a104 104 0 0 0-91.82 152.88l-11.35 34.05a16 16 0 0 0 20.24 20.24l34.05-11.35A104 104 0 1 0 128 24m0 192a87.87 87.87 0 0 1-44.06-11.81a8 8 0 0 0-6.54-.67L40 216l12.47-37.4a8 8 0 0 0-.66-6.54A88 88 0 1 1 128 216"/></g></svg>
          Comienza ahora
        </a>
        <a href="/diagnostico" style="display: inline-flex; align-items: center; min-height: 52px; padding: 0 24px; border-radius: 14px; background: #F2ECE1; color: #0B1533; text-decoration: none; font-weight: 500; font-size: 16px">Diagnóstico gratis</a>
      </div>
      <p style="margin: 0; font-size: 14px; color: #6B7085">Primera conversación sin costo · Sin permanencia · Respuesta por WhatsApp</p>
    </div>

    <!-- celular con el reporte + guiños de e-commerce -->
    <div style="position: relative; display: flex; justify-content: center; min-width: 0; padding-block: 24px">
      <div aria-hidden="true" style="position: absolute; inset: 6% 6% 6% 6%; border-radius: 40px; background: #EAF1FF"></div><svg class="dd draw" aria-hidden="true" viewBox="0 0 100 100" width="84" height="84" style="position: absolute; color: #0034D3; right: 2%; top: 0; transform: rotate(-6deg); z-index: 1"><path pathLength="1" d="M10 76 L32 52 L48 64 L82 28"/><path pathLength="1" d="M62 26 L84 26 L84 48"/></svg><svg class="dd draw" aria-hidden="true" viewBox="0 0 100 100" width="46" height="46" style="position: absolute; color: #99CCFF; left: 10%; bottom: 8%; z-index: 1"><path pathLength="1" d="M50 12 C 54 40, 60 46, 88 50 C 60 54, 54 60, 50 88 C 46 60, 40 54, 12 50 C 40 46, 46 40, 50 12 Z"/></svg><svg class="dd draw" aria-hidden="true" viewBox="0 0 100 100" width="62" height="62" style="position: absolute; color: #0034D3; right: 4%; bottom: 2%; z-index: 1; transform: rotate(8deg)"><path pathLength="1" d="M20 72 Q50 88 80 72"/><path pathLength="1" d="M20 56 Q50 72 80 56"/><path pathLength="1" d="M20 40 Q50 56 80 40 Q50 22 20 40"/></svg>

      <div class="float fl1" aria-hidden="true" style="position: absolute; left: 0; top: 64px; z-index: 2; display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 16px; background: #FFFFFF; box-shadow: 0 16px 32px -16px rgba(14,21,18,0.3); font-size: 13px">
        <span style="display: grid; place-items: center; width: 30px; height: 30px; border-radius: 10px; background: #EAF1FF; color: #0034D3"><svg width="16" height="16" viewBox="0 0 256 256"><g fill="currentColor"><path d="m224 64l-12.16 66.86A16 16 0 0 1 196.1 144H70.55L56 64Z" opacity=".2"/><path d="M230.14 58.87A8 8 0 0 0 224 56H62.68L56.6 22.57A8 8 0 0 0 48.73 16H24a8 8 0 0 0 0 16h18l25.56 140.29a24 24 0 0 0 5.33 11.27a28 28 0 1 0 44.4 8.44h45.42a27.75 27.75 0 0 0-2.71 12a28 28 0 1 0 28-28H91.17a8 8 0 0 1-7.87-6.57L80.13 152h116a24 24 0 0 0 23.61-19.71l12.16-66.86a8 8 0 0 0-1.76-6.56M104 204a12 12 0 1 1-12-12a12 12 0 0 1 12 12m96 0a12 12 0 1 1-12-12a12 12 0 0 1 12 12m4-74.57a8 8 0 0 1-7.9 6.57H77.22L65.59 72h148.82Z"/></g></svg></span>
        <span style="display: flex; flex-direction: column"><b style="font-weight: 600">Nuevo pedido #1043</b><span style="color: #6B7085; font-family: 'Geist Mono', monospace; font-size: 12px">$45.990</span></span>
      </div>
      <div class="float fl2" aria-hidden="true" style="position: absolute; right: 0; bottom: 96px; z-index: 2; display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 16px; background: #FFFFFF; box-shadow: 0 16px 32px -16px rgba(14,21,18,0.3); font-size: 13px">
        <span style="display: grid; place-items: center; width: 30px; height: 30px; border-radius: 10px; background: #EAF1FF; color: #0034D3"><svg width="16" height="16" viewBox="0 0 256 256"><g fill="currentColor"><path d="M224 56v152l-32-16l-32 16l-32-16l-32 16l-32-16l-32 16V56a8 8 0 0 1 8-8h176a8 8 0 0 1 8 8" opacity=".2"/><path d="M72 104a8 8 0 0 1 8-8h96a8 8 0 0 1 0 16H80a8 8 0 0 1-8-8m8 40h96a8 8 0 0 0 0-16H80a8 8 0 0 0 0 16m152-88v152a8 8 0 0 1-11.58 7.15L192 200.94l-28.42 14.21a8 8 0 0 1-7.16 0L128 200.94l-28.42 14.21a8 8 0 0 1-7.16 0L64 200.94l-28.42 14.21A8 8 0 0 1 24 208V56a16 16 0 0 1 16-16h176a16 16 0 0 1 16 16m-16 0H40v139.06l20.42-10.22a8 8 0 0 1 7.16 0L96 199.06l28.42-14.22a8 8 0 0 1 7.16 0L160 199.06l28.42-14.22a8 8 0 0 1 7.16 0L216 195.06Z"/></g></svg></span>
        <span style="display: flex; flex-direction: column"><b style="font-weight: 600">Boleta emitida</b><span style="color: #6B7085; font-size: 12px">y registrada en tu libro</span></span>
      </div>

      <div style="position: relative; width: 300px; max-width: 100%; border-radius: 44px; background: #0B1533; padding: 10px; box-shadow: 0 40px 80px -40px rgba(14,21,18,0.45)">
        <div style="border-radius: 36px; background: #FFFFFF; overflow: hidden; display: flex; flex-direction: column">
          <div style="padding: 26px 20px 8px; display: flex; flex-direction: column; gap: 4px">
            <p style="margin: 0; font-size: 11px; color: #6B7085">Tu tienda · septiembre · <span style="font-weight: 600">ejemplo</span></p>
            <p style="margin: 0; font-size: 26px; font-weight: 600; letter-spacing: -0.03em; line-height: 1.1">Ganaste <span style="color: #0034D3">$2.650.000</span></p>
            <p style="margin: 0; font-size: 12px; color: #6B7085">21% de lo que vendiste, sin IVA</p>
          </div>
          <div style="padding: 12px 20px; display: flex; flex-direction: column; gap: 9px; font-size: 12px">
            <div style="display: flex; flex-direction: column; gap: 4px"><div style="display: flex; justify-content: space-between"><span>Ventas · 186 pedidos</span><span style="font-family: 'Geist Mono', monospace">$12,4 M</span></div><div style="height: 6px; border-radius: 99px; background: #0034D3"></div></div>
            <div style="display: flex; flex-direction: column; gap: 4px"><div style="display: flex; justify-content: space-between; color: #4A5068"><span>Productos</span><span style="font-family: 'Geist Mono', monospace">−$5,0 M</span></div><div style="height: 6px; width: 40%; border-radius: 99px; background: #D6D3CB"></div></div>
            <div style="display: flex; flex-direction: column; gap: 4px"><div style="display: flex; justify-content: space-between; color: #4A5068"><span>Meta Ads</span><span style="font-family: 'Geist Mono', monospace">−$2,1 M</span></div><div style="height: 6px; width: 17%; border-radius: 99px; background: #D6D3CB"></div></div>
            <div style="display: flex; flex-direction: column; gap: 4px"><div style="display: flex; justify-content: space-between; color: #4A5068"><span>Costos fijos</span><span style="font-family: 'Geist Mono', monospace">−$2,3 M</span></div><div style="height: 6px; width: 19%; border-radius: 99px; background: #D6D3CB"></div></div>
          </div>
          <div style="margin: 8px 12px 12px; padding: 14px; border-radius: 20px; background: #F2ECE1; display: flex; flex-direction: column; gap: 10px">
            <div style="display: flex; justify-content: space-between; align-items: center"><span style="font-size: 12px; font-weight: 500">ROAS de Meta</span><span style="font-size: 11px; font-weight: 500; padding: 3px 8px; border-radius: 99px; background: #D6E4FF; color: #0034D3">Sobre el mínimo</span></div>
            <div style="position: relative; height: 8px; border-radius: 99px; background: linear-gradient(90deg, #F6DDDA 0 30%, #D6E4FF 30% 100%)">
              <span style="position: absolute; left: 30%; top: -4px; width: 2px; height: 16px; background: #0B1533"></span>
              <span style="position: absolute; left: 88%; top: -4px; width: 16px; height: 16px; border-radius: 50%; background: #0034D3; border: 3px solid #FFFFFF; transform: translateX(-50%)"></span>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 11px; color: #6B7085; font-family: 'Geist Mono', monospace"><span>mínimo 1,8</span><span>tuyo 5,9</span></div>
          </div>
          <div style="margin: 0 12px 16px; padding: 12px 14px; border-radius: 16px; border: 1px solid #E3E1DA; display: flex; gap: 10px; align-items: center">
            <span aria-hidden="true" style="width: 30px; height: 30px; border-radius: 50%; background: #0034D3; display: grid; place-items: center; color: #FFFFFF"><svg width="12" height="12" viewBox="0 0 256 256"><path fill="currentColor" d="M240 128a15.74 15.74 0 0 1-7.6 13.51L88.32 229.65a16 16 0 0 1-16.2.3A15.86 15.86 0 0 1 64 216.13V39.87a15.86 15.86 0 0 1 8.12-13.82a16 16 0 0 1 16.2.3l144.08 88.14A15.74 15.74 0 0 1 240 128"/></svg></span>
            <span style="font-size: 12px">Video del mes · 3 min</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- LOGOS -->
<section class="wrap" style="padding-block: 8px 56px; display: flex; flex-direction: column; gap: 16px">
