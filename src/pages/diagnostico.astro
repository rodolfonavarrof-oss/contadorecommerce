---
import Base from '../layouts/Base.astro';
import { WHATSAPP_NUMBER } from '../config';

const questions = [
  '¿Tu contador emite cada mes las facturas de compra de Meta, Google y Shopify?',
  '¿Sabes cuánto ganaste (tu utilidad) el mes pasado?',
  '¿Alguien cuadra lo que vendió tu tienda con las boletas que emitiste?',
  '¿Alguien cuadra lo que te depositaron Mercado Pago, Flow o Webpay con tus ventas?',
  '¿Conoces tu ROAS de equilibrio, el mínimo para no perder plata en Meta?',
  '¿Tu contador te explica qué pagas en el F29 y por qué?',
  '¿Tu contador te responde en menos de 48 horas?',
  '¿Recibes un reporte mensual con los números de tu negocio?',
];
---
<Base
  title="Diagnóstico gratis: ¿tu contador está haciendo esto?"
  description="8 preguntas de sí o no para saber si la contabilidad de tu tienda online está al día: facturas de compra de Meta y Shopify, cuadre de ventas, ROAS de equilibrio y más."
>
  <section class="narrow section stack" style="gap: 32px">
    <div class="stack" style="gap: 12px">
      <p class="eyebrow">Diagnóstico gratis · 2 minutos</p>
      <h1 class="h1" style="font-size: clamp(34px, 4.6vw, 48px)">¿Tu contador está haciendo esto?</h1>
      <p class="lead" style="font-size: 18px">Responde 8 preguntas de sí o no y te decimos cómo está la contabilidad de tu tienda. No pedimos tus datos.</p>
    </div>

    <form id="quiz" class="stack" style="gap: 24px" data-wa={WHATSAPP_NUMBER} novalidate>
      <div class="quiz">
        {questions.map((q, i) => (
          <fieldset class="q">
            <legend class="sr-only" style="position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0)">Pregunta {i + 1}</legend>
            <p>{q}</p>
            <div class="q-options">
              <label><input type="radio" name={`q${i}`} value="1" required /><span>Sí</span></label>
              <label><input type="radio" name={`q${i}`} value="0" /><span>No</span></label>
            </div>
          </fieldset>
        ))}
      </div>
      <p id="quiz-error" class="small" role="alert" style="margin: 0; color: #a3341a"></p>
      <div><button type="submit" class="btn btn-primary">Ver mi resultado</button></div>
    </form>

    <div id="result" class="result" hidden tabindex="-1">
      <p class="small">Tu puntaje</p>
      <p class="score"><span id="score">0</span> / 8</p>
      <h2 id="result-title" class="h2" style="font-size: 30px"></h2>
      <p id="result-text" class="muted" style="font-size: 18px"></p>
      <div class="actions">
        <a id="result-wa" href="/#contacto" class="btn btn-primary">Revisemos tu caso por WhatsApp</a>
        <a href="/#newsletter" class="btn btn-outline">Suscribirme al newsletter</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('quiz') as HTMLFormElement;
  const result = document.getElementById('result') as HTMLElement;
  const error = document.getElementById('quiz-error') as HTMLElement;

  const tiers = [
    {
      min: 7,
      title: 'Vas bien.',
      text: 'Tu contabilidad acompaña a tu tienda. Si quieres ir un paso más allá, el newsletter te mantiene al día con cada cambio del SII.',
    },
    {
      min: 4,
      title: 'Hay cosas que conviene revisar.',
      text: 'Algunas piezas importantes no se están cubriendo. Lo más común es que falten facturas de compra o que nadie cuadre las ventas con las pasarelas, y eso suele aparecer después como una diferencia con el SII.',
    },
    {
      min: 0,
      title: 'Tu contabilidad no está acompañando a tu tienda.',
      text: 'Hoy no tienes claro cuánto ganas y hay obligaciones que probablemente no se están cumpliendo. Tiene solución: lo primero es revisar qué falta y ponerte al día.',
    },
  ];

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    let answered = 0;
    let score = 0;
    for (let i = 0; i < 8; i++) {
      const v = data.get(`q${i}`);
      if (v !== null) {
        answered++;
        score += Number(v);
      }
    }
    if (answered < 8) {
      error.textContent = `Te faltan ${8 - answered} pregunta${8 - answered === 1 ? '' : 's'} por responder.`;
      return;
    }
    error.textContent = '';
    const tier = tiers.find((t) => score >= t.min)!;
    (document.getElementById('score') as HTMLElement).textContent = String(score);
    (document.getElementById('result-title') as HTMLElement).textContent = tier.title;
    (document.getElementById('result-text') as HTMLElement).textContent = tier.text;
    const wa = form.dataset.wa || '';
    const link = document.getElementById('result-wa') as HTMLAnchorElement;
    if (/^\d{10,13}$/.test(wa)) {
      const msg = `Hola, hice el diagnóstico en contadorecommerce.cl y saqué ${score} de 8. Quiero revisar mi caso.`;
      link.href = `https://wa.me/${wa}?text=${encodeURIComponent(msg)}`;
    }
    result.hidden = false;
    result.focus();
    result.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>
