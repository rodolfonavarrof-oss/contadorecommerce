---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada" noindex>
  <section class="narrow section stack" style="gap: 20px">
    <h1 class="h1" style="font-size: clamp(34px, 4.6vw, 48px)">Esta página no existe.</h1>
    <p class="lead" style="font-size: 18px">Puede que el enlace esté mal escrito o que la página se haya movido.</p>
    <div class="actions">
      <a href="/" class="btn btn-primary">Ir al inicio</a>
      <a href="/blog" class="btn btn-outline">Ver el blog</a>
    </div>
  </section>
</Base>
